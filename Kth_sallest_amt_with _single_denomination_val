class Solution {
    public long findKthSmallest(int[] coins, int k) {
        long lef = 1;
        long righ = (long) coins[0] * k;

        for (int coin : coins) {
            righ = Math.min(righ, (long) coin * k);
        }

        while (lef < righ) {
            long middle = lef + (righ - lef) / 2;

            if (count(middle, coins) >= k) {
                righ = middle;
            } else {
                lef = middle + 1;
            }
        }

        return lef;
    }

    private long count(long x, int[] coins) {
        int n = coins.length;
        long total = 0;

        for (int mask = 1; mask < (1 << n); mask++) {
            long lcm = 1;
            int bits = 0;
            boolean overflow = false;

            for (int i = 0; i < n; i++) {
                if ((mask & (1 << i)) != 0) {
                    bits++;

                    long g = gcd(lcm, coins[i]);
                    long next = lcm / g * coins[i];

                    if (next > x) {
                        overflow = true;
                        break;
                    }

                    lcm = next;
                }
            }

            if (!overflow) {
                long value = x / lcm;

                if (bits % 2 == 1) {
                    total += value;
                } else {
                    total -= value;
                }
            }
        }

        return total;
    }

    private long gcd(long a, long b) {
        while (b != 0) {
            long temp = a % b;
            a = b;
            b = temp;
        }
        return a;
    }
}
