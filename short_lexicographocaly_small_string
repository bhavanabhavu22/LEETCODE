class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        int side = 0;
        int one = 0;
        String answer = "";

        for (int right = 0; right < s.length(); right++) {
            if (s.charAt(right) == '1') {
                one++;
            }

            while (one > k) {
                if (s.charAt(side) == '1') {
                    one--;
                }
                side++;
            }

            if (one == k) {
                while (s.charAt(side) == '0') {
                    side++;
                }

                String curr = s.substring(side, right + 1);

                if (answer.equals("") ||
                    curr.length() < answer.length() ||
                    (curr.length() == answer.length() &&
                     curr.compareTo(answer) < 0)) {
                    answer = curr;
                }
            }
        }

        return answer;
    }
}
