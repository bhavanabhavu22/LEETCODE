import java.util.*;

class Solution {
    public int leastInterval(char[] tasks, int n) {

        int[] freq = new int[26];

        // Count frequency of each task
        for (char task : tasks) {
            freq[task - 'A']++;
        }

        // Max heap
        PriorityQueue<Integer> maxHeap =
            new PriorityQueue<>(Collections.reverseOrder());

        for (int f : freq) {
            if (f > 0) {
                maxHeap.offer(f);
            }
        }

        int time = 0;

        while (!maxHeap.isEmpty()) {

            List<Integer> temp = new ArrayList<>();

            // One cycle has n + 1 positions
            for (int i = 0; i <= n; i++) {

                if (!maxHeap.isEmpty()) {
                    int current = maxHeap.poll();

                    if (current - 1 > 0) {
                        temp.add(current - 1);
                    }

                    time++;
                } 
                else {
                    // No task available
                    if (temp.isEmpty()) {
                        break;
                    }

                    time++;
                }
            }

            // Put remaining tasks back
            for (int f : temp) {
                maxHeap.offer(f);
            }
        }

        return time;
    }
}
