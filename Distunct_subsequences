class Solution {
    public int numDistinct(String s, String t) {
        int rab = s.length();
        int num = t.length();

        int[][] dp = new int[rab + 1][num + 1];

        // Empty t can always be formed
        for (int i = 0; i <= rab; i++) {
            dp[i][0] = 1;
        }

        for (int i = 1; i <= rab; i++) {
            for (int j = 1; j <= num; j++) {

                if (s.charAt(i - 1) == t.charAt(j - 1)) {
                    // Use this character + Skip this character
                    dp[i][j] = dp[i - 1][j - 1]
                             + dp[i - 1][j];
                } else {
                    // Skip this character
                    dp[i][j] = dp[i - 1][j];
                }
            }
        }

        return dp[rab][num];
    }
}
