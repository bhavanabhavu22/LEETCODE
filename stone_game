class Solution {

    public int stoneGameV(int[] stoneValue) {

        int n = stoneValue.length;

        int[] prefix = new int[n + 1];

        
        for (int i = 0; i < n; i++) {
            prefix[i + 1] = prefix[i] + stoneValue[i];
        }

        int[][] dp = new int[n][n];

      
        for (int len = 2; len <= n; len++) {

            for (int left = 0; left + len <= n; left++) {

                int right = left + len - 1;

                for (int mid = left; mid < right; mid++) {

                    int sumLeft = prefix[mid + 1] - prefix[left];
                    int sumRight = prefix[right + 1] - prefix[mid + 1];

                    if (sumLeft < sumRight) {
                        dp[left][right] = Math.max(
                            dp[left][right],
                            sumLeft + dp[left][mid]
                        );
                    }
                    else if (sumRight < sumLeft) {
                        dp[left][right] = Math.max(
                            dp[left][right],
                            sumRight + dp[mid + 1][right]
                        );
                    }
                    else {
                        dp[left][right] = Math.max(
                            dp[left][right],
                            sumLeft + Math.max(
                                dp[left][mid],
                                dp[mid + 1][right]
                            )
                        );
                    }
                }
            }
        }

        return dp[0][n - 1];
    }
}
