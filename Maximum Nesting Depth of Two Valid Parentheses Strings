class Solution {
    public int[] maxDepthAfterSplit(String seq) {

        int[] ans = new int[seq.length()];
        int depth = 0;

        for (int i = 0; i < seq.length(); i++) {

            if (seq.charAt(i) == '(') {
                depth++;

                // Alternate between group 0 and group 1
                ans[i] = depth % 2;
            } else {
                // Use current depth before decreasing
                ans[i] = depth % 2;

                depth--;
            }
        }

        return ans;
    }
}
