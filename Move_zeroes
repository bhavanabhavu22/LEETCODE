class Solution {
    public void moveZeroes(int[] nums) {
        int ind = 0;

        // Move all non-zero elements to the front
        for (int i = 0; i < nums.length; i++) {
            if (nums[i] != 0) {
                nums[ind] = nums[i];
                ind++;
            }
        }

        // Fill the remaining positions with zeros
        while (ind< nums.length) {
            nums[ind] = 0;
            ind++;
        }
    }
}
